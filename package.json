{
  "name": "ejar-masr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project ejar-masr-test \"vitest run --config vitest.rules.config.ts\"",
    "gen:data": "node scripts/gen-locations.mjs && node scripts/gen-indexes.mjs",
    "preview": "wrangler pages dev dist",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:emulators": "firebase emulators:exec --only auth,firestore --project demo-ejar-e2e \"playwright test\"",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:rules",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "e2e:install": "playwright install --with-deps chromium",
    "build:e2e": "tsc --noEmit -p tsconfig.build.json && VITE_USE_EMULATORS=true VITE_FIREBASE_API_KEY=e2e-fake-key VITE_FIREBASE_AUTH_DOMAIN=localhost VITE_FIREBASE_PROJECT_ID=demo-ejar-e2e VITE_FIREBASE_APP_ID=1:1:web:e2e vite build"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@eslint/js": "^9.15.0",
    "@firebase/rules-unit-testing": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "egydata": "^1.1.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jose": "^5.9.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
