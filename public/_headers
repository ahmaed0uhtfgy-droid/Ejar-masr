# Security headers for static files (the SPA shell and /assets). Function responses get the same values from functions/_middleware.ts.
# Keep in sync with functions/_lib/securityHeaders.ts (a test fails if they drift).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-vBxvsvGPYDDjNR9jdf4PGZGDtTdXGI5bsi7UF2K+L7k=' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://tile.openstreetmap.org https://*.basemaps.cartocdn.com https://*.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://api.cloudinary.com https://nominatim.openstreetmap.org https://cloudflareinsights.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://apis.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/design/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=86400

/logo.svg
  Cache-Control: public, max-age=86400
